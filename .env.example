SEPSIS_DB_PASSWORD=replace-with-a-random-long-secret
SEPSIS_DATABASE_URL=postgresql+psycopg://sepsis:replace-with-a-random-long-secret@127.0.0.1:55432/sepsis
SEPSIS_DEMO_ACCOUNTS=1
SEPSIS_EMR_KEY=replace-with-a-separate-random-secret-at-least-32-characters
# Set one exact HTTPS origin and disable demo accounts before public hosting.
# SEPSIS_PUBLIC_ORIGIN=https://your-host.example
# Enable prospective silent validation mode (persists predictions in DB, hides clinician-facing alerts).
# SEPSIS_SILENT_MODE=0
